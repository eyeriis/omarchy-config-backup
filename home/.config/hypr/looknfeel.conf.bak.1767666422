# Change the default Omarchy look'n'feel

# https://wiki.hyprland.org/Configuring/Variables/#general
general {
    # No gaps between windows
    # gaps_in = 0
    # gaps_out = 0

    # Use master layout instead of dwindle
    # layout = master

	windowrulev2 = opacity 0.60 0.60, class:^(Spotify)$
windowrulev2 = opacity 0.85 0.85, class:^(Document Viewer)$
windowrulev2 = opacity 0.85 0.85, class:^(alacritty)$
}

# https://wiki.hyprland.org/Configuring/Variables/#decoration
decoration {
    rounding = 15

    shadow {
        enabled = true
        range = 16
        render_power = 2
        color = rgba(00000066)
    }

    blur {
        enabled = true
        size = 8
        passes = 3
        vibrancy = 0.18
        ignore_opacity = true
    }
}


