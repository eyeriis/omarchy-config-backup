#!/bin/bash

for candidate in /sys/class/power_supply/BAT*; do
  [[ -r "$candidate/capacity" ]] && battery="$candidate" && break
done
[[ -n "$battery" ]] || exit 1

read -r capacity < "$battery/capacity"
read -r status < "$battery/status"
[[ "$capacity" =~ ^[0-9]+$ ]] || exit 1

theme_css="$HOME/.config/omarchy/current/theme/waybar.css"
foreground="$(sed -n 's/^[[:space:]]*@define-color[[:space:]]\+foreground[[:space:]]\+\(#[[:xdigit:]]\{6\}\).*/\1/p' "$theme_css" | head -n 1)"
background="$(sed -n 's/^[[:space:]]*@define-color[[:space:]]\+background[[:space:]]\+\(#[[:xdigit:]]\{6\}\).*/\1/p' "$theme_css" | head -n 1)"
[[ "$foreground" =~ ^#[[:xdigit:]]{6}$ ]] || foreground="#f5f5f7"
[[ "$background" =~ ^#[[:xdigit:]]{6}$ ]] || background="#111113"

label="$capacity"
text_x="16"
bolt_light=""
bolt_dark=""
if [[ "$status" == "Charging" ]]; then
  text_x="12"
  bolt_light="<path d='M23 5 20.5 10h2.2l-1.2 5 4.7-6h-2.3l1.2-4z' fill='$foreground'/>"
  bolt_dark="<path d='M23 5 20.5 10h2.2l-1.2 5 4.7-6h-2.3l1.2-4z' fill='$background' clip-path='url(#charged)'/>"
fi
fill_width=$((31 * capacity / 100))
output="/tmp/waybar-macos-battery-$UID.svg"

printf '<svg xmlns="http://www.w3.org/2000/svg" width="34" height="21" viewBox="0 0 36 22"><defs><clipPath id="body"><rect x="1" y="2" width="31" height="18" rx="4"/></clipPath><clipPath id="charged"><rect x="1" y="2" width="%s" height="18"/></clipPath></defs><rect x="1" y="2" width="31" height="18" rx="4" fill="%s" fill-opacity=".34"/><rect x="1" y="2" width="%s" height="18" fill="%s" clip-path="url(#body)"/><rect x="33" y="7" width="3" height="8" rx="1.5" fill="%s" fill-opacity=".62"/><text x="%s" y="11" text-anchor="middle" dominant-baseline="central" font-family="JetBrainsMono Nerd Font Propo" font-size="12" font-weight="700" fill="%s">%s</text>%s<text x="%s" y="11" text-anchor="middle" dominant-baseline="central" font-family="JetBrainsMono Nerd Font Propo" font-size="12" font-weight="700" fill="%s" clip-path="url(#charged)">%s</text>%s</svg>\n' "$fill_width" "$foreground" "$fill_width" "$foreground" "$foreground" "$text_x" "$foreground" "$label" "$bolt_light" "$text_x" "$background" "$label" "$bolt_dark" > "$output"
printf '%s\n%s%% · %s\n' "$output" "$capacity" "$status"
