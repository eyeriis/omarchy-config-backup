#!/bin/bash

for candidate in /sys/class/power_supply/BAT*; do
  [[ -r "$candidate/capacity" ]] && battery="$candidate" && break
done
[[ -n "$battery" ]] || exit 1

read -r capacity < "$battery/capacity"
read -r status < "$battery/status"
[[ "$capacity" =~ ^[0-9]+$ ]] || exit 1

label="$capacity"
text_x="19"
bolt_light=""
bolt_dark=""
if [[ "$status" == "Charging" ]]; then
  text_x="15.5"
  bolt_light="<path d='M26.5 6 23.8 11h2.4l-1.3 5 5-6.2h-2.5l1.3-3.8z' fill='#f5f5f5'/>"
  bolt_dark="<path d='M26.5 6 23.8 11h2.4l-1.3 5 5-6.2h-2.5l1.3-3.8z' fill='#111111' clip-path='url(#charged)'/>"
fi
fill_width=$((36 * capacity / 100))
output="/tmp/waybar-macos-battery-$UID.svg"

printf '<svg xmlns="http://www.w3.org/2000/svg" width="42" height="24" viewBox="0 0 42 24"><defs><clipPath id="body"><rect x="1" y="3" width="36" height="18" rx="4"/></clipPath><clipPath id="charged"><rect x="1" y="3" width="%s" height="18"/></clipPath></defs><rect x="1" y="3" width="36" height="18" rx="4" fill="#6e6e73"/><rect x="1" y="3" width="%s" height="18" fill="#f5f5f7" clip-path="url(#body)"/><rect x="38" y="8" width="3" height="8" rx="1.5" fill="#8e8e93"/><text x="%s" y="12.4" text-anchor="middle" dominant-baseline="middle" font-family="Liberation Sans,sans-serif" font-size="12.8" font-weight="700" letter-spacing="-0.6" fill="#f5f5f7">%s</text>%s<text x="%s" y="12.4" text-anchor="middle" dominant-baseline="middle" font-family="Liberation Sans,sans-serif" font-size="12.8" font-weight="700" letter-spacing="-0.6" fill="#111113" clip-path="url(#charged)">%s</text>%s</svg>\n' "$fill_width" "$fill_width" "$text_x" "$label" "$bolt_light" "$text_x" "$label" "$bolt_dark" > "$output"
printf '%s\n%s%% · %s\n' "$output" "$capacity" "$status"
